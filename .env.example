PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# Set this to protect the web panel when publicly deployed
APP_PASSWORD=

# AI provider: openai, anthropic, gemini, or openai-compatible
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# For openai-compatible providers (including providers with a compatible endpoint)
AI_BASE_URL=
# Optional comma-separated provider fallback order; requires a key per provider
AI_FALLBACK_ORDER=openai,anthropic,gemini

# GitHub personal access token (fine-grained token with only required repo permissions)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Render API key
RENDER_API_KEY=

# Firebase: use a service account JSON file path for Admin/management operations where supported
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Firebase Hosting deployment additionally requires Firebase CLI authorization / CI token.
FIREBASE_TOKEN=
